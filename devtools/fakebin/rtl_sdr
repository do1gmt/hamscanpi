#!/usr/bin/env python3
"""Ersatz für rtl_sdr in Tests: Rauschen in Echtzeit (ohne -n) bzw. so schnell wie möglich (mit -n).
FAKE_SIGNALS="439200000:fm,446006250:fm" fügt FM-Signale (Sprachersatz: 300–2700 Hz Wobbelton, 3 kHz Hub) ein."""
import os, sys, time, numpy as np
a = sys.argv
n = int(a[a.index('-n') + 1]) if '-n' in a else None
fc = float(a[a.index('-f') + 1]) if '-f' in a else 0.0
fs = float(a[a.index('-s') + 1]) if '-s' in a else 1024000.0
sigs = []
for spec in filter(None, os.environ.get("FAKE_SIGNALS", "").split(",")):
    f, kind = (spec.split(":") + ["fm"])[:2]
    if abs(float(f) - fc) < fs / 2 * 0.95:
        sigs.append(float(f) - fc)
rng = np.random.default_rng(); blk = 96000; sent = 0; t0 = time.time(); k = 0; ph = [0.0] * len(sigs); t_s = 0.0; ph_a = [0.0]
try:
    while n is None or sent < n:
        m = blk if n is None else min(blk, n - sent)
        z = (rng.standard_normal(m) + 1j * rng.standard_normal(m)) * 6
        if sigs:
            t = t_s + np.arange(m) / fs
            fa = 1500 + 1000 * np.sin(2 * np.pi * 0.7 * t)                 # Ton wandert 500–2500 Hz
            pa = ph_a[0] + 2 * np.pi * np.cumsum(fa) / fs
            ph_a[0] = float(pa[-1] % (2 * np.pi))
            mod = np.sin(pa)
            for i, off in enumerate(sigs):
                inst = off + 3000 * mod
                p = ph[i] + 2 * np.pi * np.cumsum(inst) / fs
                ph[i] = float(p[-1] % (2 * np.pi))
                z = z + 40 * np.exp(1j * p)
        t_s += m / fs
        out = np.empty(2 * m, np.uint8)
        out[0::2] = np.clip(z.real + 127.5, 0, 255); out[1::2] = np.clip(z.imag + 127.5, 0, 255)
        sys.stdout.buffer.write(out.tobytes()); sys.stdout.flush()
        sent += m; k += 1
        if n is None:
            d = t0 + k * blk / fs - time.time()
            if d > 0: time.sleep(d)
except (BrokenPipeError, KeyboardInterrupt):
    pass
