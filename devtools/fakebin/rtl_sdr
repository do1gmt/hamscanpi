#!/usr/bin/env python3
import sys, time, numpy as np
a = sys.argv; n = int(a[a.index('-n')+1]) if '-n' in a else None
rng = np.random.default_rng(); blk = 96000; sent = 0; t0 = time.time(); k = 0
try:
    while n is None or sent < n:
        m = blk if n is None else min(blk, n - sent)
        z = rng.standard_normal(m*2)*6+127.5
        sys.stdout.buffer.write(np.clip(z,0,255).astype(np.uint8).tobytes()); sys.stdout.flush()
        sent += m; k += 1
        if n is None:
            d = t0 + k*0.1 - time.time()
            if d > 0: time.sleep(d)
except (BrokenPipeError, KeyboardInterrupt):
    pass
